# ===== 数据库（PostgreSQL 16）=====
DATABASE_URL="postgresql://xiuxiu:xiuxiu@localhost:5432/xiuxiu?schema=public"

# ===== 后台账号 =====
ADMIN_USERNAME=admin
# 生成方式：pnpm hash-password 你的密码
ADMIN_PASSWORD_HASH=
# 会话签名密钥（生产必须替换为随机 32 位以上字符串）
SESSION_SECRET=dev-only-please-change-me

# ===== 消息通知（PRD §6.1）=====
# console = 本地开发仅打印终端；wecom = 企业微信机器人；serverchan = Server 酱
NOTIFY_PROVIDER=console
WECOM_WEBHOOK_URL=
SERVERCHAN_KEY=

# ===== 上传限流（技术防护，非 PRD 验收项）=====
UPLOAD_RATE_LIMIT_PER_HOUR=30

# ===== 种子模式：demo=本地/预发（含演示数据）；admin=生产（仅管理员）=====
SEED_MODE=demo

# ===== 站点 =====
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_NAME=xiu xiu
NEXT_PUBLIC_SHOP_PHONE=18029516310
NEXT_PUBLIC_SHOP_HOURS=每天 9:00–17:00
